## Cross-Library Patterns

### Zustand + Zod: Schema-Driven Stores

```typescript
export type TodoItem = z.infer<typeof TodoItem>;
export const TodoItem = z.object({
  id: z.string(),
  title: z.string().min(1),
  completed: z.boolean(),
  order: z.int().min(0),
});

interface TodoStore {
  items: TodoItem[];
  addTodo: (input: Omit<TodoItem, 'id' | 'order'>) => void;
  reorder: (fromIndex: number, toIndex: number) => void;
}
```

### Zustand + dnd-kit: Drag-Reorder State

```typescript
import { move } from '@dnd-kit/helpers';

const useBoardStore = create<BoardStore>()(
  immer((set) => ({
    columns: {},
    reorderCards: (event: DragEndEvent) => {
      set((state) => {
        state.columns = move(state.columns, event);
      });
    },
  }))
);
```

### Zod + dnd-kit: Validate Drops

```typescript
const DropTarget = z.object({
  accepts: z.array(z.enum(['card', 'task', 'file'])),
  maxItems: z.int().min(1),
});

function canDrop(target: z.infer<typeof DropTarget>, itemType: string): boolean {
  return target.accepts.includes(itemType as any);
}
```
